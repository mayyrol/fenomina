server:
  port: 8090

spring:
  application:
    name: api-gateway
  cloud:
    gateway:
      routes:
        - id: auth-service
          uri: ${GATEWAY_ROUTE_AUTH_URI:http://localhost:8081}
          predicates:
            - Path=/auth/**
        - id: master-data-service
          uri: ${GATEWAY_ROUTE_MASTER_URI:http://localhost:8082}
          predicates:
            - Path=/api/master/**
        - id: payroll-engine
          uri: ${GATEWAY_ROUTE_PAYROLL_URI:http://localhost:8083}
          predicates:
            - Path=/api/payroll/**
        - id: historicos-service
          uri: ${GATEWAY_ROUTE_HISTORICOS_URI:http://localhost:8084}
          predicates:
            - Path=/api/historicos/**

jwt:
  secret: REEMPLAZAR_CON_TU_JWT_SECRET

gateway:
  auth:
    excluded-paths:
      - /auth/login
      - /auth/refresh

logging:
  level:
    root: INFO
    com.fenomina.gateway: DEBUG
    org.springframework.cloud.gateway: DEBUG

management:
  endpoints:
    web:
      exposure:
        include: health
  endpoint:
    health:
      show-details: never