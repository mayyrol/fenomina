# ============================================================
# Dockerfile.master — master-data-service
# Ejecutar desde la raíz del proyecto fenomina/
# ============================================================

FROM maven:3.9.6-eclipse-temurin-17 AS build
WORKDIR /app

COPY pom.xml ./pom.xml
COPY services/auth-service/pom.xml ./services/auth-service/pom.xml
COPY services/master-data-service/pom.xml ./services/master-data-service/pom.xml
COPY services/payroll_engine/pom.xml ./services/payroll_engine/pom.xml
COPY services/historicos-service/pom.xml ./services/historicos-service/pom.xml
COPY services/api_gateway/pom.xml ./services/api_gateway/pom.xml

RUN mvn dependency:go-offline -pl services/master-data-service -am -q

COPY services/master-data-service/src ./services/master-data-service/src

RUN mvn clean package -pl services/master-data-service -am -DskipTests -q

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

RUN addgroup -S fenomina && adduser -S fenomina -G fenomina

# Directorio para logos — será montado como volumen
RUN mkdir -p /app/uploads/logos && chown -R fenomina:fenomina /app/uploads

USER fenomina

COPY --from=build /app/services/master-data-service/target/*.jar app.jar

EXPOSE 8082

ENTRYPOINT ["java", "-jar", "app.jar"]
